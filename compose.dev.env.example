# Template for compose.dev.yaml credentials — copy to compose.dev.env and
# adjust (gitignored; never commit the real file). compose.dev.yaml refuses
# to start while values are missing. Change every value before exposing the
# stack beyond 127.0.0.1 (it never should be).
AUTHENTIK_DB_PASSWORD=change-me-dev-postgres
AUTHENTIK_SECRET_KEY=change-me-dev-secret-key-0123456789
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-dev-akadmin
AUTHENTIK_BOOTSTRAP_TOKEN=change-me-dev-bootstrap-token