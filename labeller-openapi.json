{"openapi":"3.1.0","info":{"title":"transaction-labeller","description":"Labels bank transactions with category names generated dynamically by a local LLM (Ollama). There is no fixed taxonomy: the model invents short, consistent labels in the requested language. Direction is implied by the amount sign; the client receives only the label.","license":{"name":"MIT"},"version":"0.2.0"},"paths":{"/v1/health":{"get":{"tags":["service"],"summary":"GET /v1/health — liveness + backend reachability.","operationId":"health","responses":{"200":{"description":"Service alive and Ollama reachable","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HealthResponse"}}}},"503":{"description":"Service alive but backend degraded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HealthResponse"}}}}}}},"/v1/label":{"post":{"tags":["labelling"],"summary":"POST /v1/label — single transaction.","operationId":"label_single","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LabelSingleRequest"}}},"required":true},"responses":{"200":{"description":"The transaction id paired with its LLM-generated category name","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SingleLabelResponse"}}}},"400":{"description":"Invalid input (bad language, over-long field)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"422":{"description":"Body fails validation (e.g. non-finite amount)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"503":{"description":"LLM backend unreachable/overloaded; Retry-After: 5","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}}}},"/v1/label:batch":{"post":{"tags":["labelling"],"summary":"POST /v1/label:batch — parallel labelling of up to `max_batch` transactions.","operationId":"label_batch","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LabelBatchRequest"}}},"required":true},"responses":{"200":{"description":"One {id, label} per input transaction, in input order; items never fail wholesale (generic fallback label instead)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BatchLabelResponse"}}}},"400":{"description":"Empty batch, duplicate ids, bad language, over-long fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"413":{"description":"Batch exceeds TL_MAX_BATCH (default 100)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"422":{"description":"Body fails validation (e.g. non-finite amount)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"503":{"description":"LLM backend unreachable/overloaded; Retry-After: 5","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}}}}},"components":{"schemas":{"ApiError":{"type":"object","description":"Uniform error body: `{ \"error\": { \"code\", \"message\", \"details\" } }`.","required":["error"],"properties":{"error":{"$ref":"#/components/schemas/ErrorBody"}}},"BatchLabelResponse":{"type":"object","description":"One result per input transaction, in input order (`results[i]` ↔\nrequest transaction `i`); `id` makes association explicit.","required":["results"],"properties":{"results":{"type":"array","items":{"$ref":"#/components/schemas/LabeledTransaction"},"example":[{"id":"a","label":"Lebensmittel"},{"id":"b","label":"Miete"}]}}},"ErrorBody":{"type":"object","required":["code","message"],"properties":{"code":{"type":"string","description":"Machine-readable error code (`invalid_request`, `backend_unavailable`).","example":"invalid_request"},"details":{"type":"array","items":{"type":"string"},"description":"Optional extra context (e.g. offending indices)."},"message":{"type":"string","description":"Human-readable description.","example":"duplicate transaction id \"tx-1\"; ids must be unique"}}},"HealthResponse":{"type":"object","description":"`GET /v1/health` response.","required":["status","backend"],"properties":{"backend":{"type":"string","description":"Backend reachability description.","example":"reachable"},"status":{"type":"string","description":"`ok` or `degraded`.","example":"ok"}}},"LabelBatchRequest":{"type":"object","description":"`POST /v1/label:batch` request body.","required":["transactions"],"properties":{"options":{"$ref":"#/components/schemas/LabelOptions"},"transactions":{"type":"array","items":{"$ref":"#/components/schemas/Transaction"},"description":"1..=`TL_MAX_BATCH` (default 100) transactions; ids must be unique."}}},"LabelOptions":{"type":"object","description":"Per-request options; language overrides the server default.","properties":{"language":{"type":["string","null"],"description":"ISO 639-1 label language (`de`, `en`, …). Overrides `TL_LANGUAGE`.","example":"de"}}},"LabelSingleRequest":{"type":"object","description":"`POST /v1/label` request body.","required":["transaction"],"properties":{"options":{"$ref":"#/components/schemas/LabelOptions"},"transaction":{"$ref":"#/components/schemas/Transaction"}}},"LabeledTransaction":{"type":"object","description":"A transaction id paired with its LLM-generated label.","required":["id","label"],"properties":{"id":{"type":"string","description":"Echoes the input transaction id.","example":"tx-1"},"label":{"type":"string","description":"LLM-generated category name in the requested language.","example":"Lebensmittel"}}},"SingleLabelResponse":{"type":"object","description":"The label, with the id it belongs to.","required":["id","label"],"properties":{"id":{"type":"string","description":"Echoes the input transaction id.","example":"tx-1"},"label":{"type":"string","description":"LLM-generated category name in the requested language.","example":"Lebensmittel"}}},"Transaction":{"type":"object","description":"A single banking transaction to be labelled. `amount` must be finite\n(NaN and ±Infinity rejected at deserialization).","required":["id","amount"],"properties":{"amount":{"type":"number","format":"double","description":"Signed amount; negative = outflow, positive = inflow.\nMust be finite.","example":-42.13},"counterparty":{"type":"string","description":"Payee (outgoing) or payer (incoming) name.","example":"REWE SAGT DANKE","maxLength":512},"currency":{"type":"string","description":"ISO 4217 currency code (advisory; shown to the model).","example":"EUR","maxLength":8},"date":{"type":"string","description":"Booking date, ISO 8601 recommended.","example":"2026-02-14","maxLength":512},"id":{"type":"string","description":"Unique identifier within the request; results are returned in input\norder, so batch clients can associate by position.","example":"tx-1","maxLength":512},"purpose":{"type":"string","description":"Purpose / reference line from the statement.","example":"Einkauf 14.02","maxLength":512}}}}},"tags":[{"name":"labelling","description":"Transaction labelling"},{"name":"service","description":"Service metadata: health"}]}